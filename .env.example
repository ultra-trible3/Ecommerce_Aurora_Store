# Copy this file to `.env` and adjust the values.
# `.env` is read automatically by config/settings/base.py and is git-ignored.

# ---------------------------------------------------------------- app
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
TIME_ZONE=UTC

# ---------------------------------------------------------------- site
SITE_NAME=Aurora Store
SITE_TAGLINE=Modern essentials, delivered fast.
SITE_URL=http://localhost:8000
SUPPORT_EMAIL=support@example.com
SUPPORT_PHONE=+1 (555) 010-2030
CURRENCY=USD
CURRENCY_SYMBOL=$
TAX_RATE=0.0
DEFAULT_PAGINATION=12

# ---------------------------------------------------------------- database
# Leave empty to use SQLite (db.sqlite3). Set a URL for PostgreSQL in production:
# DATABASE_URL=postgres://user:password@localhost:5432/store
DATABASE_URL=
DB_CONN_MAX_AGE=60
DB_SSLMODE=prefer

# ---------------------------------------------------------------- email
# Dev prints emails to the console; production should set SMTP values.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=shop@example.com

# ---------------------------------------------------------------- payments
# Cash on delivery works with no keys. Stripe / PayPal appear at checkout
# only when their keys are set.
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox

# ---------------------------------------------------------------- security (production)
# ENABLE_SSL=True
# SECURE_HSTS_SECONDS=2592000
SESSION_COOKIE_AGE=1209600

# ---------------------------------------------------------------- logging
# Threshold written to logs/ (DEBUG|INFO|WARNING|ERROR|CRITICAL).
# server.log always captures every level at or above this; debug.log captures
# DEBUG only. The console always shows INFO and above.
LOG_LEVEL=DEBUG
